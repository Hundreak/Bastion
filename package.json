{
  "name": "bastion",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop SSH console: multi-terminal, SFTP browser, and atomic deploys driven by a project descriptor rather than a hardcoded fleet.",
  "author": {
    "name": "Remzi Altunay"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5188\" \"wait-on tcp:5188 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5188 electron . --no-sandbox\"",
    "build": "vite build",
    "start": "electron . --no-sandbox",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.6",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.bastion.console",
    "productName": "Bastion",
    "copyright": "Copyright © 2026 Remzi Altunay",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Remzi Altunay",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "deb": {
      "maintainer": "Remzi Altunay"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bastion"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hundreak/Bastion.git"
  }
}
